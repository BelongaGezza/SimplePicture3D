{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capability for SimplePicture3D",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-load-image",
    "allow-depth-inference",
    "allow-depth-read",
    "allow-depth-adjust",
    "allow-mask",
    "allow-point-cloud",
    "allow-presets",
    "allow-settings",
    "allow-model"
  ]
}
